# =====================================================================================================
# Astrotalk Live Relay — configuration
# Copy this file to ".env" and fill in the values. Lines starting with # are comments.
# NEVER commit your real ".env" file or share it. It contains secrets.
# =====================================================================================================

# --- Database --------------------------------------------------------------------------------------
# Local development without Docker (run "npm run db:up" in another terminal window first):
#   postgresql://astro:astro@localhost:5433/astrotalk
# Local development with Docker (docker compose -f docker-compose.dev.yml up -d):
#   postgresql://astro:astro@localhost:5432/astrotalk
# Production (docker-compose.yml sets this for you; you do not need to set it in production).
DATABASE_URL="postgresql://astro:astro@localhost:5433/astrotalk"

# --- LiveKit (video server) ------------------------------------------------------------------------
# LiveKit Cloud: Project > Settings shows the URL (wss://YOUR-PROJECT.livekit.cloud). Keys: Settings > API Keys > Add key.
# Self-hosted LiveKit: your own server, e.g. wss://livekit.example.com — only these variables change, no code changes.
# Used by our SERVER (and the worker):
LIVEKIT_URL="wss://YOUR-PROJECT.livekit.cloud"
LIVEKIT_API_KEY="APIxxxxxxxxxxxx"
LIVEKIT_API_SECRET="replace-with-your-livekit-api-secret"   # SECRET. Server only.
# Same address, but handed to the browsers (astrologer pages). Must start with NEXT_PUBLIC_.
NEXT_PUBLIC_LIVEKIT_URL="wss://YOUR-PROJECT.livekit.cloud"

# --- Where this app lives --------------------------------------------------------------------------
# The PUBLIC https address of this app. LiveKit's servers open ${NEXT_PUBLIC_APP_URL}/egress-layout over the internet
# to draw the Instagram picture, so this must be reachable from the internet.
#   Production:  https://live.yourcompany.com
#   Local dev:   your Cloudflare Tunnel / ngrok address, e.g. https://random-words.trycloudflare.com  (see README)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Ops console login -----------------------------------------------------------------------------
# The shared password for /ops. At least 8 characters; make it long.
OPS_PASSWORD="change-me-to-a-long-password"
# Random text used to sign login cookies. At least 32 characters. Generate one with:  openssl rand -hex 32
SESSION_SECRET="replace-with-64-random-hex-characters-replace-with-64-random-hex"

# --- Behaviour (all optional; the values shown are the defaults) ------------------------------------
# Name of the one LiveKit room everyone joins.
ROOM_NAME="astrotalk-live"
# Astrologers can connect (green room) this many minutes before their shift.
GREEN_ROOM_LEAD_MINUTES=10
# After a shift ends, the person stays connected (but cannot publish) this many seconds, then is removed.
HANDOFF_GRACE_SECONDS=30
# Time zone used to DISPLAY times. Everything is stored in UTC. (The app is built for India: Asia/Kolkata.)
TZ_DISPLAY="Asia/Kolkata"

# Folder for the uploaded transition video (in Docker this is a persistent volume; you do not need to set it).
# UPLOAD_DIR="./data/uploads"

# --- Production only (used by docker-compose.yml and the Caddyfile) -------------------------------------
# Your domain name, pointing at the server. Caddy gets the HTTPS certificate for it automatically.
DOMAIN="live.example.com"
# Password for the Postgres database container.
POSTGRES_PASSWORD="change-me-too"
