# syntax=docker/dockerfile:1
# The schedule enforcer (worker/index.ts). Also used, with a different command, to run database migrations.

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
# devDependencies are installed on purpose: "tsx" (runs TypeScript directly) and "prisma" (migrations) live there.
RUN npm ci --include=dev
COPY prisma ./prisma
COPY src ./src
COPY worker ./worker
COPY tsconfig.json ./
RUN npx prisma generate
USER node
# Create / upgrade the database tables first (safe to repeat: it only applies what is missing), then run the worker.
# Doing it here, rather than relying on a platform setting, means the tables always exist after a deploy.
CMD ["sh", "-c", "npx prisma migrate deploy && npx tsx worker/index.ts"]
